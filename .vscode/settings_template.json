  // Completely halt the default Microsoft diagnostics engine
  "C_Cpp.errorSquiggles": "disabled",
  "C_Cpp.intelliSenseEngine": "disabled",

  // Allow clangd to talk to your UCRT64 GCC driver
  "clangd.arguments": [
      "--background-index",
      "--clang-tidy",
      "--compile-commands-dir=<replace with full path to project>/build/gcc-debug",
      "--query-driver=C:/msys64/ucrt64/bin/g++.exe",
      "-j=1",
      "--log=verbose",
      "--experimental-modules-support"
      //,
      // "--limit-results=0"
      // "--pch-storage=disk"
  ],

  // Explicitly bind the language client to handle syntax and diagnostics
  "editor.suggest.snippetsPreventQuickSuggestions": false,
  "editor.inlayHints.enabled": "offUnlessPressed"
}