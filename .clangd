CompileFlags:
  CompilationDatabase: "build/gcc-debug"
  Remove: [
    -fmodule-mapper=*,
    -fdeps-format=*,
    -fmodules-ts,
    -fmodules,
    -fmodule-header,
    -fmodule-header=*
  ]
  Add: [
    -std=c++23,
    -Xclang,
    -fallow-pcm-with-compiler-errors,
    --target=x86_64-w64-mingw32
  ]
  Compiler: C:/msys64/ucrt64/bin/g++.exe

---
# Aggressively bypass the entire build directory to stop URI generation failures
If:
  PathMatch: [.*build/.*, .*build\\.*]
Diagnostics:
  Suppress: "*"
Index:
  Background: Skip
